{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/:path*/", "destination": "https://kisa.backend.deo-core.codes/api/:path*/" },
    { "source": "/api/:path*", "destination": "https://kisa.backend.deo-core.codes/api/:path*" },
    { "source": "/((?!api/|assets/|images/).*)", "destination": "/index.html" }
  ]
}
