# Django
DJANGO_SECRET_KEY=your-super-secret-key-change-in-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,kisa.deo-core.codes

# Database (PostgreSQL)
POSTGRES_DB=kisa_shop
POSTGRES_USER=kisa
POSTGRES_PASSWORD=secure-password-here

# Redis
REDIS_URL=redis://redis:6379/0

# Email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.yourprovider.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@domain.com
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=noreply@kisa.shop
CSRF_TRUSTED_ORIGINS=https://kisa.deo-core.codes
